# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (for pgvector embeddings) ───────────────────────
OPENAI_API_KEY=OpenAI-key-...

# ─── Upstash Redis (BullMQ queue) ───────────────────────────
# Use rediss:// for TLS (required by Upstash)
UPSTASH_REDIS_REST_URL=rediss://your-endpoint.upstash.io:6380

# ─── API Key Encryption ─────────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=64-char-hex-string

# ─── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── CMS (set per deployment) ───────────────────────────────
CONTENTFUL_SPACE_ID=your-space-id
# SANITY_PROJECT_ID and STRAPI_BASE_URL are stored in project config

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
